{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/Jose-Ribeir/claude-code-review-gate/schemas/finding.schema.json",
  "title": "review-gate output",
  "description": "Output of the /review-gate:review skill in --json mode.",
  "type": "object",
  "required": ["status", "verdict", "summary", "findings"],
  "properties": {
    "status": {
      "type": "string",
      "enum": ["success", "completed_with_warnings", "completed_with_errors", "skipped"]
    },
    "verdict": {
      "type": "string",
      "enum": ["block", "warn", "pass"]
    },
    "summary": {
      "type": "object",
      "required": ["files_reviewed", "findings", "high", "medium", "low"],
      "properties": {
        "files_reviewed": { "type": "integer", "minimum": 0 },
        "findings": { "type": "integer", "minimum": 0 },
        "high": { "type": "integer", "minimum": 0 },
        "medium": { "type": "integer", "minimum": 0 },
        "low": { "type": "integer", "minimum": 0 }
      }
    },
    "findings": {
      "type": "array",
      "items": { "$ref": "#/definitions/finding" }
    },
    "project_summary": { "type": "string" },
    "warnings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "file": { "type": "string" },
          "message": { "type": "string" }
        }
      }
    }
  },
  "definitions": {
    "finding": {
      "type": "object",
      "required": ["path", "start_line", "end_line", "severity", "confidence", "category", "content"],
      "properties": {
        "path": { "type": "string" },
        "start_line": { "type": "integer", "minimum": 0 },
        "end_line": { "type": "integer", "minimum": 0 },
        "severity": { "type": "string", "enum": ["high", "medium", "low"] },
        "confidence": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
        "category": {
          "type": "string",
          "enum": ["correctness", "security", "performance", "maintainability", "test_coverage"]
        },
        "content": { "type": "string" },
        "suggestion_code": { "type": "string" },
        "existing_code": { "type": "string" },
        "evidence": {
          "type": "string",
          "description": "What Grep/Read was called and what it showed. Required for cross-file claims."
        },
        "thinking": { "type": "string" }
      }
    }
  }
}
