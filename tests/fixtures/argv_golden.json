{
  "_comment": "Normalized argv from review_gate._run_review for a first push of ≤15 files (0.7.0 baseline). Scenarios 13 and 20 compare byte-for-byte after normalisation. Normalised: claude executable → '<claude>', plugin root → '<plugin-dir>', push range in prompt → '<RANGE>'.",
  "argv": [
    "<claude>",
    "-p",
    "/review-gate:review --range <RANGE> --json",
    "--allowedTools",
    "Bash(git diff *)",
    "Bash(git ls-files *)",
    "Bash(git log *)",
    "Bash(git show *)",
    "Bash(git rev-parse *)",
    "Bash(git status *)",
    "Read",
    "Grep",
    "Glob",
    "Task",
    "--disallowedTools",
    "Write",
    "Edit",
    "NotebookEdit",
    "WebFetch",
    "WebSearch",
    "--model",
    "sonnet",
    "--setting-sources",
    "",
    "--plugin-dir",
    "<plugin-dir>",
    "--mcp-config",
    "{\"mcpServers\":{}}",
    "--strict-mcp-config",
    "--exclude-dynamic-system-prompt-sections"
  ]
}
