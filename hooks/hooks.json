{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/gate-hook.sh\"",
            "shell": "bash",
            "if": "Bash(*git push*)",
            "timeout": 1920,
            "statusMessage": "Reviewing unpushed commits (review-gate)..."
          },
          {
            "type": "command",
            "command": "powershell",
            "args": [
              "-NoProfile",
              "-ExecutionPolicy",
              "Bypass",
              "-File",
              "${CLAUDE_PLUGIN_ROOT}/scripts/gate-hook.ps1"
            ],
            "if": "Bash(*git push*)",
            "timeout": 1920,
            "statusMessage": "Reviewing unpushed commits (review-gate)..."
          }
        ]
      }
    ]
  }
}
