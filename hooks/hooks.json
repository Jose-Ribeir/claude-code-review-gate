{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/gate-hook.sh\"",
            "shell": "bash",
            "if": "Bash(git *)",
            "timeout": 1920,
            "statusMessage": "Reviewing unpushed commits (review-gate)..."
          },
          {
            "type": "command",
            "command": "powershell",
            "args": [
              "-NoProfile",
              "-ExecutionPolicy",
              "Bypass",
              "-File",
              "${CLAUDE_PLUGIN_ROOT}/scripts/gate-hook.ps1"
            ],
            "if": "Bash(git *)",
            "timeout": 1920,
            "statusMessage": "Reviewing unpushed commits (review-gate)..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/post-hook.sh\"",
            "shell": "bash",
            "timeout": 30,
            "statusMessage": "review-gate: checking for findings..."
          },
          {
            "type": "command",
            "command": "powershell",
            "args": [
              "-NoProfile",
              "-ExecutionPolicy",
              "Bypass",
              "-File",
              "${CLAUDE_PLUGIN_ROOT}/scripts/post-hook.ps1"
            ],
            "timeout": 30,
            "statusMessage": "review-gate: checking for findings..."
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/session-start-check.sh\"",
            "shell": "bash",
            "timeout": 15,
            "statusMessage": "review-gate: checking for Python 3..."
          },
          {
            "type": "command",
            "command": "powershell",
            "args": [
              "-NoProfile",
              "-ExecutionPolicy",
              "Bypass",
              "-File",
              "${CLAUDE_PLUGIN_ROOT}/scripts/session-start-check.ps1"
            ],
            "timeout": 15,
            "statusMessage": "review-gate: checking for Python 3..."
          }
        ]
      }
    ]
  }
}
