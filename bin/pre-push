#!/usr/bin/env bash
#
# review-gate — global git pre-push gate (the optional "everywhere" wiring,
# installed by install-git-hook.sh). Reviews all unpushed commits via the
# official `claude` CLI and blocks confident high-severity findings.
#
# This is a PRE-PUSH hook, not pre-commit, and that is load-bearing: the gate
# reviews `@{u}..HEAD` (all unpushed commits). During a pre-commit hook the new
# commit does not exist yet, so HEAD still points at its parent — the staged
# changes being committed would never be reviewed, and the already-reviewed
# commits behind HEAD would be re-reviewed on every single commit.
#
# __SCR_BIN__ is replaced with the plugin's bin/ path at install time.
set -euo pipefail

SCR_BIN="${SCR_BIN:-__SCR_BIN__}"

# Extra headless args for this path only: allow the review's read-only tools to
# run non-interactively. review-gate.py's DEFAULT_CLAUDE_ARGS already supplies
# --plugin-dir and the cost controls (pinned model, no user settings, no MCP),
# and OCR_CLAUDE_EXTRA_ARGS is APPENDED to them rather than replacing them.
#
# Use OCR_CLAUDE_ARGS instead if you want to replace the defaults wholesale --
# but note that discards the cost controls along with everything else.
if [ -z "${OCR_CLAUDE_ARGS:-}" ] && [ -z "${OCR_CLAUDE_EXTRA_ARGS:-}" ]; then
  export OCR_CLAUDE_EXTRA_ARGS="--dangerously-skip-permissions"
fi

# git feeds pre-push the ref updates on stdin. review-gate.py --mode git does
# not read stdin (only --mode hook does), so capture the lines here and pass
# them on to any chained repo-local hook, which may well expect them.
REFS="$(cat || true)"

# Pick a WORKING Python interpreter; skip Windows Store alias stubs (which can't
# execute). If none works, fail open (skip review) rather than block the push.
PY=""
for _c in python3 python py; do
  _p="$(command -v "$_c" 2>/dev/null)" || continue
  case "$_p" in *[Ww]indows[Aa]pps*) continue ;; esac
  if "$_p" -c "import sys" >/dev/null 2>&1; then PY="$_p"; break; fi
done

RC=0
if [ -n "$PY" ] && [ -f "$SCR_BIN/review-gate.py" ]; then
  "$PY" "$SCR_BIN/review-gate.py" --mode git </dev/null || RC=$?
fi

# core.hooksPath overrides a repo's own .git/hooks/pre-push; don't silently
# disable it — run it too (only if we didn't already block), replaying the ref
# lines we consumed above on its stdin.
GITDIR="$(git rev-parse --git-dir 2>/dev/null || echo .git)"
LOCAL="$GITDIR/hooks/pre-push"
if [ "$RC" -eq 0 ] && [ -x "$LOCAL" ] && [ "$LOCAL" -ef "$0" ] 2>/dev/null; then
  : # guard: never recurse into ourselves
elif [ "$RC" -eq 0 ] && [ -x "$LOCAL" ]; then
  printf '%s\n' "$REFS" | "$LOCAL" "$@" || RC=$?
fi

exit "$RC"
