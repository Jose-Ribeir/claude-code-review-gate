#!/usr/bin/env bash
#
# review-gate — global git pre-commit gate (the optional "everywhere"
# wiring, installed by install-git-hook.sh). Reviews staged changes via the
# official `claude` CLI and blocks confident high-severity findings. Fails open.
#
# __SCR_BIN__ is replaced with the plugin's bin/ path at install time.
set -euo pipefail

SCR_BIN="${SCR_BIN:-__SCR_BIN__}"

# Default headless args: load the plugin from disk so /review-gate:review resolves
# even when the plugin isn't formally installed, and allow the review's read-only
# tools to run non-interactively. Override by exporting OCR_CLAUDE_ARGS yourself.
if [ -z "${OCR_CLAUDE_ARGS:-}" ]; then
  export OCR_CLAUDE_ARGS="--plugin-dir __PLUGIN_ROOT__ --dangerously-skip-permissions"
fi

# Pick a WORKING Python interpreter; skip Windows Store alias stubs (which can't
# execute). If none works, fail open (skip review) rather than block the commit.
PY=""
for _c in python3 python py; do
  _p="$(command -v "$_c" 2>/dev/null)" || continue
  case "$_p" in *[Ww]indows[Aa]pps*) continue ;; esac
  if "$_p" -c "import sys" >/dev/null 2>&1; then PY="$_p"; break; fi
done

RC=0
if [ -n "$PY" ] && [ -f "$SCR_BIN/review-gate.py" ]; then
  "$PY" "$SCR_BIN/review-gate.py" --mode git || RC=$?
fi

# core.hooksPath overrides a repo's own .git/hooks/pre-commit; don't silently
# disable it — run it too (only if we didn't already block).
GITDIR="$(git rev-parse --git-dir 2>/dev/null || echo .git)"
LOCAL="$GITDIR/hooks/pre-commit"
if [ "$RC" -eq 0 ] && [ -x "$LOCAL" ] && [ "$LOCAL" -ef "$0" ] 2>/dev/null; then
  : # guard: never recurse into ourselves
elif [ "$RC" -eq 0 ] && [ -x "$LOCAL" ]; then
  "$LOCAL" "$@" || RC=$?
fi

exit "$RC"
